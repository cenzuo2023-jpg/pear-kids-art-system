[
  "890: <!-- 年龄/性别 -->",
  "891: <td class=\"py-3 px-3 text-gray-700 dark:text-gray-300 whitespace-nowrap text-sm\">",
  "892: <span class=\"font-mono font-semibold\">{{ s.age || '-' }}</span> 岁 · {{ s.gender || '女' }}",
  "893: </td>",
  "894: ",
  "895: <!-- 所属班级 -->",
  "896: <td class=\"py-3 px-4 whitespace-nowrap\">",
  "897: <span class=\"font-semibold text-sm text-[#111827] dark:text-gray-200\">{{ getClassById(s.classId).name }}</span>",
  "898: </td>",
  "899: ",
  "900: <!-- 剩余课时 (Notion 显眼状态标签) -->",
  "901: <td class=\"py-3 px-4 whitespace-nowrap font-mono font-bold\">",
  "902: <span :class=\"s.remainHours <= 0 ? 'nt-tag-red' : s.remainHours <= 3 ? 'nt-tag-yellow' : 'nt-tag-green'\"",
  "903: class=\"px-2.5 py-1 rounded text-sm inline-block font-mono\">",
  "904: 余 {{ s.remainHours }} 节",
  "905: </span>",
  "906: </td>",
  "907: ",
  "908: <!-- 画币积分 -->",
  "909: <td class=\"py-3 px-3 whitespace-nowrap\">",
  "910: <button @click.stop=\"openIndividualPointModal(s, 'add')\"",
  "911: class=\"nt-tag-gold cursor-pointer hover:border-amber-400 transition\"",
  "912: :title=\"'点击为【' + s.name + '】变更积分'\">",
  "913: <span>⭐ {{ s.points || 0 }}</span>",
  "914: <span class=\"text-[9px] opacity-60 ml-0.5\">▾</span>",
  "915: </button>",
  "916: </td>",
  "917: ",
