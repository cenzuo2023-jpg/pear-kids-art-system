[
  "6456: // 监听状态变化同步到 URL Hash (仅在非 profile 状态下保持主页干净)",
  "6457: watch([currentTab, rosterSubTab, () => profileStudent.value?.id, () => selectedClassDetail.value?.id], () => {",
  "6458: if (isSyncingHash.value) return;",
  "6459: let targetHash = '#' + currentTab.value;",
  "6460: if (currentTab.value === 'profile' && profileStudent.value) {",
  "6461: targetHash = '#student-' + profileStudent.value.id;",
  "6462: } else if (currentTab.value === 'class_detail' && selectedClassDetail.value) {",
  "6463: targetHash = '#class-' + selectedClassDetail.value.id;",
  "6464: } else if (currentTab.value === 'students') {",
  "6465: if (rosterSubTab.value === 'archive') targetHash = '#archive';",
  "6466: else if (rosterSubTab.value === 'students') targetHash = '#students-roster';",
  "6467: else targetHash = '#students-classes';",
  "6468: } else if (currentTab.value === 'records') {",
  "6469: targetHash = '#finance';",
  "6470: } else if (currentTab.value === 'attendance') {",
  "6471: targetHash = '#attendance';",
  "6472: }",
  "6473: if (window.location.hash !== targetHash) {",
  "6474: window.history.replaceState(null, '', targetHash);",
  "6475: }",
  "6476: });",
  "6477: ",
  "6478: window.addEventListener('popstate', syncStateFromHash);",
  "6479: window.addEventListener('hashchange', syncStateFromHash);",
  "6480: ",
  "6481: onMounted(() => {",
  "6482: applyTheme();",
  "6483: loadData();",
  "6484: syncStateFromHash();",
  "6485: window.addEventListener('click', handleGlobalClick);",
  "6486: });",
  "6487: </script>"
]